const WHATSAPP_NUMBER='918856874068';
const products=['Agarbatti','Dhup','Kapoor','Wati','Attar','Halad','Kunku','Ashtgandha','Vastramal'];
function options(){return products.map(p=>`<option>${p}</option>`).join('')}
function addProduct(){const box=document.getElementById('productRows');const row=document.createElement('div');row.className='product-row';row.innerHTML=`<div class="field"><label>Product</label><select name="product[]" required>${options()}</select></div><div class="field"><label>Quantity</label><input name="quantity[]" type="number" min="1" value="1" required></div><div class="field"><label>Price (₹)</label><input name="price[]" type="number" min="0" placeholder="Price"></div><button type="button" class="remove-product">Remove</button>`;box.appendChild(row)}
function submitBooking(e){e.preventDefault();if(WHATSAPP_NUMBER.includes('REPLACE')){alert('Please set your WhatsApp Business number in js/script.js first.');return}const d=new FormData(e.target);const ps=d.getAll('product[]'),qs=d.getAll('quantity[]'),pr=d.getAll('price[]');let items=ps.map((p,i)=>`${i+1}. ${p} | Qty: ${qs[i]||1} | Price: ₹${pr[i]||'—'}`).join('\n');const msg=`NEW POOJA ARTICLES BOOKING\n\nName: ${d.get('name')}\nMobile: ${d.get('mobile')}\nEmail: ${d.get('email')||'None'}\nProducts:\n${items}\nPayment: ${d.get('payment')}\nAdvance: ₹${d.get('advance')||'0'}\nDelivery: ${d.get('delivery')}\nDate: ${d.get('date')}\nAddress: ${d.get('address')}\nNote: ${d.get('note')||'None'}\n\nS.B. Joshi Enterprises`;window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`,'_blank','noopener')}
document.addEventListener('DOMContentLoaded',()=>{const current=location.pathname.split('/').pop()||'index.html';document.querySelectorAll('nav a').forEach(a=>{if(a.getAttribute('href')===current)a.classList.add('active')});const add=document.getElementById('addProduct');if(add)add.onclick=addProduct;const rows=document.getElementById('productRows');if(rows)rows.onclick=e=>{if(e.target.classList.contains('remove-product')&&rows.children.length>1)e.target.closest('.product-row').remove()};const form=document.getElementById('bookingForm');if(form)form.onsubmit=submitBooking;document.querySelectorAll('.gallery-item img').forEach(img=>img.onclick=()=>{const b=document.getElementById('lightbox'),i=document.getElementById('lightboxImg');i.src=img.src;b.classList.add('show')});const close=document.getElementById('lightboxClose');if(close)close.onclick=()=>document.getElementById('lightbox').classList.remove('show')});
